{
  "expo": {
    "name": "Sarh",
    "slug": "safat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-master.png",
    "scheme": "safat",
    "owner": "alsafa00",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.safat.app",
      "icon": "./assets/images/brand-master.png",
      "infoPlist": {
        "CFBundleDisplayName": "سرح | Sarh"
      }
    },
    "android": {
      "package": "com.safat.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-master.png",
        "backgroundColor": "#021B12"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-master.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#021B12",
          "dark": {
            "image": "./assets/images/brand-master.png",
            "imageWidth": 280,
            "resizeMode": "contain",
            "backgroundColor": "#021B12"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول لمكتبة الصور لتغيير صورة البروفايل والغلاف"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نحتاج موقعك لتحديد مكان الملحمة على الخريطة"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand-master.png",
          "color": "#021B12",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc410a8a-09ab-49bb-ba66-53c86471e9aa"
      }
    }
  }
}
