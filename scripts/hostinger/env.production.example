# Copy to /opt/sarh/.env.production — NEVER commit the real file.
# Fill RENDER_* only for one-time backup; remove after import succeeds.

# ── Hostinger Postgres (local Docker) ──
POSTGRES_USER=sarh
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=sarh

# App reads DATABASE_URL from compose override; keep in sync if running tools outside compose:
# DATABASE_URL=postgresql://sarh:PASSWORD@localhost:5432/sarh

# ── Redis (local Docker) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLED=true

# ── One-time Render backup (Phase 3 only — do not commit) ──
# RENDER_DATABASE_URL=postgresql://...

# ── Copy from Render dashboard / existing production .env ──
NODE_ENV=production
PORT=3001
APP_URL=https://your-current-api-domain.com
ALLOWED_ORIGINS=https://your-app-domain.com
JWT_SECRET=
JWT_REFRESH_SECRET=
NI_BASE_URL=
NI_OUTLET_ID=
NI_API_KEY=
NI_WEBHOOK_SECRET=
# ... all other keys from Render — see backend-nest/.env.example

SOCKET_PORT=3002
SOCKET_HTTP_PORT=3002

# Build (4GB VPS)
NODE_OPTIONS_BUILD=--max-old-space-size=3072
